# light-quant-copilot LLM 配置
# 复制此文件为 .env 并填写 API Key，或直接设置系统环境变量
# 也可在应用内"⚙️ API 设置"面板中实时配置（仅当次会话有效）

# ── AI Provider 选择 ─────────────────────────────────────────────
# mock     = 演示模式，无需 Key（默认）
# deepseek = DeepSeek Chat（国内速度快，性价比高，推荐首选）
# qwen     = 阿里千问/百炼（DashScope 兼容接口）
LLM_PROVIDER=mock

# ── DeepSeek ─────────────────────────────────────────────────────
# 获取 Key：https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 阿里千问 / 百炼（DashScope OpenAI 兼容接口）─────────────────
# 获取 Key：https://dashscope.aliyun.com → API-KEY 管理
# QWEN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── 通用参数（可选，使用默认值即可）────────────────────────────────
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=2048
# LLM_TIMEOUT=60
# LLM_MAX_RETRIES=2
